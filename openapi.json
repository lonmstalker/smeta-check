  "components": {
    "schemas": {
      "ChangeEmailRequest": {
        "type": "object",
        "required": [
          "new_email",
          "current_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "ConfirmEmailRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Тело ответа с ошибкой — единственный формат на весь API.\n`fields` появляется только у ошибок про конкретные поля формы.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "машиночитаемый код (он же ключ локализации)"
          },
          "fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "message": {
            "type": "string",
            "description": "текст на языке запроса — можно показывать пользователю как есть"
          }
        }
      },
      "Estimate": {
        "type": "object",
        "description": "Смета глазами пользователя",
        "required": [
          "id",
          "file_name",
          "size_bytes",
          "status",
          "from_photo",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "RFC 3339 в UTC; в местное время переводит браузер"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "почему не разобрали — на языке запроса; есть только у failed"
          },
          "file_name": {
            "type": "string",
            "description": "имя файла, как его назвал сам пользователь"
          },
          "from_photo": {
            "type": "boolean",
            "description": "смету прислали фотографией — её строки распознала нейросеть, и\nинтерфейс обязан честно об этом предупредить"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "description": "uploaded — принята, parsing — разбирается, parsed — разобрана,\nfailed — разобрать не смогли"
          }
        }
      },
      "EstimateDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Estimate"
          },
          {
            "type": "object",
            "required": [
              "lines"
            ],
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EstimateLine"
                }
              }
            }
          }
        ],
        "description": "Смета со строками. Строки приходят и распознанные, и сырые: нераспознанное\nпоказывается блоком «спросите бригаду, что это», а не прячется."
      },
      "EstimateLine": {
        "type": "object",
        "description": "Строка сметы: сырой текст плюс то, что удалось распознать. Пустые поля —\nчестный ответ «это место мы не поняли», а не потеря данных.",
        "required": [
          "position",
          "sheet",
          "raw_text"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "format": "int32",
            "description": "порядок строки в файле"
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "raw_text": {
            "type": "string",
            "description": "строка целиком, как её видел человек в Excel"
          },
          "sheet": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "название работы; null — строку не разобрали"
          },
          "total": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "имя поля в теле запроса, например \"password\""
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ForgotRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "requires_2fa"
        ],
        "properties": {
          "access_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "присутствует, если 2FA не требуется"
          },
          "pending_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires_2fa": {
            "type": "boolean",
            "description": "если true — второй шаг: POST /api/auth/2fa/verify с pending_token"
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          }
        }
      },
      "ResetRequest": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8
          },
          "token": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "user",
          "admin"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "description": "Сессия глазами пользователя. Время — RFC 3339 в UTC: показывать его в\nместном формате — работа браузера, а не сервера.",
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "current"
        ],
        "properties": {
          "client": {
            "type": [
              "string",
              "null"
            ],
            "description": "«Chrome, macOS» — если клиент представился"
          },
          "created_at": {
            "type": "string",
            "description": "когда вошли"
          },
          "current": {
            "type": "boolean",
            "description": "эта сессия — та, из которой пришёл запрос"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_seen_at": {
            "type": "string",
            "description": "когда сессией пользовались в последний раз"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "TotpCodeRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "TotpEnableRequest": {
        "type": "object",
        "required": [
          "secret",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        }
      },
      "TotpSetupResponse": {
        "type": "object",
        "required": [
          "secret",
          "otpauth_url"
        ],
        "properties": {
          "otpauth_url": {
            "type": "string",
            "description": "ссылка otpauth:// для приложения-аутентификатора"
          },
          "secret": {
            "type": "string",
            "description": "показать пользователю для ручного ввода"
          }
        }
      },
      "UpdateMe": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "как обращаться к пользователю; пропущено — не меняем",
            "maxLength": 100
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "язык интерфейса и писем: \"ru\" или \"en\""
          }
        }
      },
      "UploadForm": {
        "type": "object",
        "description": "Тело загрузки описано руками: генератор спеки не умеет выводить\nmultipart с файлом из сигнатуры хендлера.",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "файл сметы: xlsx, xls или фотография (jpg, png, webp), до 10 МиБ.\nФото принимается только при включённой нейросети и подтверждённой почте"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "totp_enabled",
          "email_verified"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "как обращаться к пользователю; не задано — показываем почту"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean",
            "description": "подтверждена ли почта (по ссылке из письма)"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "язык интерфейса и писем: код из i18n::ALL_LANGS"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "totp_enabled": {
            "type": "boolean",
            "description": "включён ли второй фактор"
          }
        }
      },
      "Verify2faRequest": {
        "type": "object",
        "required": [
          "pending_token",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "pending_token": {
            "type": "string"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "required": [
          "version",
          "commit"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "description": "коммит, из которого собран образ (build-arg GIT_SHA); dev-сборка — unknown"
          },
          "version": {
            "type": "string",
            "description": "версия из Cargo.toml"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
