# Прод-настройки: cp .env.prod.example .env.prod и заполнить.
# .env.prod в git не попадает.
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
# длинная случайная строка (от 16 символов): openssl rand -hex 32
# без неё приложение не поднимется — лучше упасть на старте, чем на входе
JWT_SECRET=change-me

# коммит сборки виден в /api/version; задавать при запуске:
# GIT_SHA=$(git rev-parse --short HEAD) docker compose -f compose.prod.yaml ... up -d --build
GIT_SHA=

# Необязательно: SMTP для писем (подтверждение почты, сброс пароля).
# Пусто — письма копятся в таблице outbox_emails и никуда не уходят.
SMTP_URL=
SMTP_FROM=
# пример: SMTP_URL=smtps://user:password@smtp.example.com:465
#         SMTP_FROM=no-reply@example.com
