{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!src/api/schema.d.ts",
      "!src/components/ui",
      "!dist",
      "!test-results",
      "!playwright-report",
      "!.stryker-tmp",
      "!reports",
      "!**/*.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "linter": {
    "domains": { "react": "recommended", "test": "recommended" },
    "rules": {
      "style": {
        "noJsxLiterals": "error"
      }
    }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  }
}
