DATABASE_URL=postgres://postgres:dev@localhost:5432/app
# любая длинная случайная строка от 16 символов; прод генерирует свою
# (openssl rand -hex 32). Без неё приложение не стартует — это специально.
JWT_SECRET=dev-secret-change-me
# адрес приложения: ссылки в письмах, OAuth-callback и проверка Origin
PUBLIC_URL=http://localhost:5173
# LOG_FORMAT=json      # прод: логи в JSON
# LOG_DIR=/var/log/app # писать логи также в файлы с ротацией
# METRICS_ADDR=127.0.0.1:9464
# COOKIE_SECURE=true   # прод: куки входа только по https
# TRUST_PROXY=true     # только если перед приложением стоит НАШ прокси (Caddy)
# RATE_LIMIT_AUTH_RPM=30  # запросов в минуту с IP на auth-ручки; 0 — без лимита
# RATE_LIMIT_LOGS_RPM=60  # то же для /api/logs (логи фронта шлёт и гость)
# RATE_LIMIT_UPLOAD_RPM=10  # то же для загрузки смет
# FILES_DIR=./data/files  # где лежат загруженные сметы (в проде — volume)
# WORKER_TICK_SECS=5  # как часто фоновый воркер смотрит очереди
# CORS_ORIGINS=https://app.example.com  # внешние браузерные клиенты
# SMTP_URL=smtp://localhost:1025  # make dev-mail
# SMTP_FROM=no-reply@localhost
